# ローカル開発専用。公開環境では認証と外部ストレージを必須にする。
LTM_STORAGE_DRIVER=local
AUTH_REQUIRED=0
PORT=3939
LTM_HOME=.long-term-memory
LTM_TELEMETRY=1

# Vercelでは次の値をプロジェクト環境変数へ設定する。
# Vercel: LTM_STORAGE_DRIVER=vercel
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_AUTH_DATABASE_URL=
TURSO_AUTH_DATABASE_TOKEN=
TURSO_TELEMETRY_DATABASE_URL=
TURSO_TELEMETRY_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Upstash integration with custom prefix UPSTASH_REDIS_REST
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
LTM_BLOB_PREFIX=projects
MCP_PUBLIC_URL=https://your-app.vercel.app
MCP_ALLOWED_ORIGINS=https://your-app.vercel.app
# Vercel: AUTH_REQUIRED=1
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
LTM_CURATOR_USER_ID=
LTM_MAINTENANCE_TOKEN=
LTM_BOOTSTRAP_OWNER_USER_ID=

# LTM_MCP_TOKENはサーバへ設定せず、クライアント/CI secretだけで管理する。
