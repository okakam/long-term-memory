# ローカル開発。Cloud RunではLTM_STORAGE_DRIVER=cloudとAUTH_REQUIRED=1を使う。
LTM_STORAGE_DRIVER=local
AUTH_REQUIRED=0
PORT=3939
LTM_HOME=.long-term-memory
LTM_S3_BUCKET=
LTM_S3_PREFIX=projects
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
MCP_PUBLIC_URL=http://localhost:3939
MCP_ALLOWED_ORIGINS=http://localhost:3939
LTM_CURATOR_USER_ID=
LTM_MAINTENANCE_TOKEN=

# LTM_MCP_TOKENはサーバへ設定せず、クライアント/CI secretだけで管理する。
