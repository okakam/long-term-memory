# ローカル開発。Cloud RunではLTM_STORAGE_DRIVER=cloudとAUTH_REQUIRED=1を使う。
LTM_STORAGE_DRIVER=local
AUTH_REQUIRED=0
LTM_LOCAL_USER_ID=local-user
PORT=3939
LTM_HOME=.long-term-memory
LTM_GCS_BUCKET=
LTM_GCS_PREFIX=projects
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
MCP_PUBLIC_URL=http://localhost:3939
MCP_ALLOWED_ORIGINS=http://localhost:3939
MCP_OAUTH_ENABLED=0
LTM_CURATOR_USER_ID=
LTM_MAINTENANCE_TOKEN=

# LTM_MCP_TOKENはサーバへ設定せず、クライアント/CI secretだけで管理する。
