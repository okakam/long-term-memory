# Copy to an untracked file and chmod 600.
LTM_MODE=local
DRY_RUN=1
SHARED_CAP=40
LTM_STORE=/absolute/path/to/.long-term-memory
CLAUDE_BIN=/absolute/path/to/claude
LTM_CURATOR_PATH=/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin
LTM_CURATOR_LOG_DIR=$HOME/.local/state/ltm-curator
LTM_CURATOR_MCP_CONFIG=
LTM_SNAPSHOT=
MCP_PUBLIC_URL=
LTM_MCP_TOKEN=
LTM_MAINTENANCE_TOKEN=
